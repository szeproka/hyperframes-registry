{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "skeleton-reveal",
  "type": "hyperframes:component",
  "title": "Skeleton Reveal",
  "description": "A skeleton loader transition that pulses, then cross-fades into content",
  "tags": [
    "video-primitive",
    "transition-primitive",
    "transitions-dev-port",
    "skeleton",
    "reveal",
    "transition"
  ],
  "files": [
    {
      "path": "skeleton-reveal.html",
      "target": "compositions/components/skeleton-reveal.html",
      "type": "hyperframes:snippet"
    }
  ],
  "variables": [
    {
      "id": "name",
      "type": "string",
      "role": "content",
      "label": "Name",
      "description": "Primary line revealed once the skeleton fades out.",
      "default": "Jane Cooper"
    },
    {
      "id": "detail",
      "type": "string",
      "role": "content",
      "label": "Detail",
      "description": "Secondary line under the name, such as an email or a role.",
      "default": "jane@example.com"
    },
    {
      "id": "tone",
      "type": "enum",
      "role": "style",
      "label": "Tone",
      "description": "Card palette. Light is the paper card, dark is a near-black card with the matching skeleton bars and text.",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    }
  ],
  "preview": {
    "video": "https://cdn.jsdelivr.net/gh/szeproka/hyperframes-registry@main/previews/skeleton-reveal.mp4",
    "poster": "https://raw.githubusercontent.com/szeproka/hyperframes-registry/main/previews/skeleton-reveal.jpg"
  }
}
